# Local quick start; PostgreSQL is recommended for deployment.
DATABASE_URL=sqlite:///./air_quality.db
HOST=0.0.0.0
PORT=8000
# Empty means auth disabled. If set, send X-API-Key on data endpoints.
API_KEY=
CORS_ORIGINS=["http://localhost:3000"]
# Required for Docker Compose; choose your own password.
POSTGRES_DB=air_quality
POSTGRES_USER=air_quality
POSTGRES_PASSWORD=replace-with-your-password
